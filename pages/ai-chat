    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyCatcC7yo-a7E7dLAfAWh0iv1BCSoYxUP8",
            authDomain: "smartwaterguardian.firebaseapp.com",
            databaseURL: "https://smartwaterguardian-default-rtdb.firebaseio.com",
            projectId: "smartwaterguardian",
            storageBucket: "smartwaterguardian.firebasestorage.app",
            messagingSenderId: "12612851503",
            appId: "1:12612851503:web:ee8e80d5a46ed28e95b3da"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const database = firebase.database();

        let currentUser = null;
        let userContext = {
            avgDaily: 0,
            monthlyTotal: 0,
            hasLeak: false
        };

        // ==================== AUTH ====================
        auth.onAuthStateChanged(function(user) {
            if (user) {
                currentUser = user;
                loadUserContext();
                addBotMessage("Hello! 👋 I'm your Water Assistant AI. I can help you with:\n\n• Understanding your water usage\n• Detecting potential leaks\n• Reducing your water bill\n• Billing questions\n• And more!\n\nHow can I help you today?");
            } else {
                window.location.href = 'login.php';
            }
        });

        // ==================== LOAD USER CONTEXT ====================
        function loadUserContext() {
            // Load usage data for context
            database.ref('properties/' + currentUser.uid).once('value')
                .then(snapshot => {
                    const properties = snapshot.val();
                    if (properties) {
                        const firstProperty = Object.values(properties)[0];
                        if (firstProperty && firstProperty.meterId) {
                            loadUsageContext(firstProperty.meterId);
                        }
                    }
                });
        }

        function loadUsageContext(meterId) {
            database.ref('meters/' + meterId + '/history').once('value')
                .then(snapshot => {
                    const data = snapshot.val();
                    if (data) {
                        // Calculate average daily usage
                        let total = 0;
                        let days = 0;
                        const today = new Date();
                        
                        for (let i = 0; i < 30; i++) {
                            const date = new Date(today);
                            date.setDate(date.getDate() - i);
                            const dateStr = date.toISOString().split('T')[0];
                            
                            if (data[dateStr] && data[dateStr].hourly) {
                                total += Object.values(data[dateStr].hourly).reduce((a, b) => a + b, 0);
                                days++;
                            }
                        }
                        
                        userContext.avgDaily = days > 0 ? total / days : 0;
                        userContext.monthlyTotal = total;
                    }
                });
        }

        // ==================== MESSAGE FUNCTIONS ====================
        function addBotMessage(text) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message bot';
            messageDiv.innerHTML = `
                <div class="msg-avatar">🤖</div>
                <div class="msg-content">${text.replace(/\n/g, '<br>')}</div>
            `;
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function addUserMessage(text) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message user';
            messageDiv.innerHTML = `
                <div class="msg-avatar">👤</div>
                <div class="msg-content">${text}</div>
            `;
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showTyping() {
            const messagesContainer = document.getElementById('chatMessages');
            const typingDiv = document.createElement('div');
            typingDiv.className = 'typing-indicator show';
            typingDiv.id = 'typingIndicator';
            typingDiv.innerHTML = '<span></span><span></span><span></span>';
            messagesContainer.appendChild(typingDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function hideTyping() {
            const typing = document.getElementById('typingIndicator');
            if (typing) typing.remove();
        }

        // ==================== SEND MESSAGE ====================
        function sendMessage() {
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            addUserMessage(message);
            input.value = '';
            
            // Disable send button
            document.getElementById('sendBtn').disabled = true;
            
            showTyping();
            
            // Process and respond
            setTimeout(() => {
                hideTyping();
                const response = generateResponse(message);
                addBotMessage(response);
                document.getElementById('sendBtn').disabled = false;
            }, 1000 + Math.random() * 1000);
        }

        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        function askQuick(question) {
            document.getElementById('userInput').value = question;
            sendMessage();
        }

        // ==================== AI RESPONSE GENERATOR ====================
        function generateResponse(message) {
            const lower = message.toLowerCase();
            
            // Greeting
            if (lower.match(/^(hi|hello|hey|greetings)/)) {
                return "Hello! 👋 How can I help you with your water usage today?\n\nYou can ask me about:\n• Your water usage patterns\n• Leak detection\n• Reducing your bill\n• Billing questions";
            }
            
            // Bill reduction
            if (lower.includes('reduce') || lower.includes('save') || lower.includes('lower') || lower.includes('cheaper')) {
                return "💡 **Tips to Reduce Your Water Bill:**\n\n" +
                       "1. **Fix leaks immediately** - A dripping tap can waste 20L+ per day\n" +
                       "2. **Install low-flow showerheads** - Save up to 15% on water\n" +
                       "3. **Take shorter showers** - Aim for 5 minutes or less\n" +
                       "4. **Use water-efficient appliances** - Look for 4-star ratings\n" +
                       "5. **Water plants early morning** - Reduces evaporation\n" +
                       "6. **Collect rainwater** - Use for garden and cleaning\n" +
                       "7. **Check your meter** - When no water is running, the meter should be still\n\n" +
                       "Would you like more specific advice for your usage pattern?";
            }
            
            // Leak detection
            if (lower.includes('leak') || lower.includes('drip') || lower.includes('water waste')) {
                let leakInfo = "🔍 **How to Detect Water Leaks:**\n\n" +
                    "1. **Check your meter** - Turn off all water. If the meter still moves, you have a leak.\n" +
                    "2. **Monitor night usage** - High usage between 12am-5am suggests a leak.\n" +
                    "3. **Check toilets** - Add food coloring to tank. If color appears in bowl without flushing, there's a leak.\n" +
                    "4. **Inspect pipes** - Look for damp spots, mold, or musty smells.\n" +
                    "5. **Check irrigation** - Look for water pooling in your garden.\n\n";
                
                if (userContext.hasLeak) {
                    leakInfo += "⚠️ **Your data shows potential leak patterns!** Please check your system immediately.";
                }
                
                return leakInfo;
            }
            
            // Usage patterns
            if (lower.includes('usage') || lower.includes('how much') || lower.includes('average') || lower.includes('consumption')) {
                if (userContext.avgDaily > 0) {
                    return `📊 **Your Water Usage Summary:**\n\n` +
                        `• **Average Daily Usage:** ${userContext.avgDaily.toFixed(1)} L\n` +
                        `• **Monthly Total:** ${userContext.monthlyTotal.toFixed(0)} L (${(userContext.monthlyTotal/1000).toFixed(1)} kL)\n` +
                        `• **Household Average:** 150-300 L/day\n\n` +
                        (userContext.avgDaily > 300 
                            ? "⚠️ Your usage is above average. Consider implementing water-saving measures." 
                            : "✅ Your usage is within normal range. Keep up the good work!");
                }
                return "📊 I'm still loading your usage data. Please check your dashboard for detailed analytics, or try again in a moment.";
            }
            
            // Billing
            if (lower.includes('bill') || lower.includes('payment') || lower.includes('cost') || lower.includes('price') || lower.includes('tariff')) {
                return "💰 **Billing Information:**\n\n" +
                    "**Tariff Structure (per kL):**\n" +
                    "• Tier 1 (0-6 kL): R18.50\n" +
                    "• Tier 2 (6-20 kL): R25.00\n" +
                    "• Tier 3 (20-40 kL): R35.00\n" +
                    "• Tier 4 (40+ kL): R45.00\n\n" +
                    "**Additional Charges:**\n" +
                    "• VAT: 15%\n\n" +
                    "**How to Pay:**\n" +
                    "• Go to Billing page\n" +
                    "• Select unpaid bill\n" +
                    "• Choose payment method (PayFast, Yoco, Ozow)\n" +
                    "• Confirm payment\n\n" +
                    "Would you like to calculate an estimate for your usage?";
            }
            
            // Payment methods
            if (lower.includes('pay') || lower.includes('payment method')) {
                return "💳 **Payment Methods:**\n\n" +
                    "We support the following payment options:\n\n" +
                    "1. **PayFast** - Instant EFT and card payments\n" +
                    "2. **Yoco** - Card payments (Visa, Mastercard)\n" +
                    "3. **Ozow** - Instant EFT from major banks\n" +
                    "4. **Bank Transfer** - Manual EFT (2-3 business days)\n\n" +
                    "All online payments are processed securely and reflect immediately on your account.";
            }
            
            // Temperature/Weather
            if (lower.includes('weather') || lower.includes('temperature') || lower.includes('season')) {
                return "🌤️ **Weather & Water Usage:**\n\n" +
                    "Your water usage can be affected by:\n\n" +
                    "• **Hot weather** - Increased garden watering (+30-50%)\n" +
                    "• **Rainy season** - Reduced garden watering (-20-30%)\n" +
                    "• **Load shedding** - May affect pump operations\n\n" +
                    "Tip: Adjust your irrigation schedule based on rainfall to save water!";
            }
            
            // Dashboard help
            if (lower.includes('dashboard') || lower.includes('chart') || lower.includes('graph')) {
                return "📊 **Dashboard Guide:**\n\n" +
                    "Your dashboard shows:\n\n" +
                    "• **Line Graph** - Usage trends over time (daily/hourly/monthly)\n" +
                    "• **Dot Graph** - Individual usage points, color-coded by level\n" +
                    "• **Current Flow** - Real-time water flow rate\n" +
                    "• **Leak Detection** - AI-powered leak analysis\n" +
                    "• **Monthly Estimate** - Projected usage and costs\n\n" +
                    "Use the chart controls to switch between daily, hourly, and monthly views.";
            }
            
            // Alerts
            if (lower.includes('alert') || lower.includes('notification')) {
                return "🔔 **Alerts & Notifications:**\n\n" +
                    "You receive alerts for:\n\n" +
                    "• **High Usage** - When usage exceeds thresholds\n" +
                    "• **Leak Detection** - Unusual continuous flow\n" +
                    "• **Low Battery** - When device battery is low\n" +
                    "• **Device Offline** - When meter loses connection\n" +
                    "• **Bill Reminders** - Upcoming payment due dates\n\n" +
                    "Configure your thresholds in the Thresholds page.";
            }
            
            // Thresholds
            if (lower.includes('threshold') || lower.includes('limit') || lower.includes('setting')) {
                return "⚙️ **Alert Thresholds:**\n\n" +
                    "You can set these thresholds:\n\n" +
                    "• **Daily Limit** - Max daily usage (default: 1000L)\n" +
                    "• **Hourly Limit** - Max hourly usage (default: 100L)\n" +
                    "• **Leak Duration** - Continuous flow time (default: 2 hours)\n" +
                    "• **Flow Rate** - Max flow rate (default: 20 L/min)\n\n" +
                    "Go to Thresholds page to customize these settings.";
            }
            
            // Device/Meter
            if (lower.includes('meter') || lower.includes('device') || lower.includes('battery')) {
                return "📟 **Device Information:**\n\n" +
                    "• **Model:** ESP32-YF-S201\n" +
                    "• **Battery:** Check Profile page for status\n" +
                    "• **Connectivity:** WiFi (2.4GHz)\n" +
                    "• **Update Frequency:** Every 5 seconds\n\n" +
                    "If your device shows offline:\n" +
                    "1. Check power connection\n" +
                    "2. Verify WiFi connection\n" +
                    "3. Check battery level\n" +
                    "4. Contact support if issue persists";
            }
            
            // Thanks
            if (lower.includes('thank') || lower.includes('thanks')) {
                return "You're welcome! 😊 I'm here to help anytime. Is there anything else you'd like to know about your water usage?";
            }
            
            // Default response
            return "🤔 I'm not sure I understand that question. Here are some things I can help with:\n\n" +
                "• **Usage:** Ask about your water consumption\n" +
                "• **Leaks:** Learn how to detect leaks\n" +
                "• **Billing:** Understand your bill and payment options\n" +
                "• **Savings:** Get tips to reduce your water bill\n" +
                "• **Devices:** Troubleshoot meter issues\n\n" +
                "Try asking something like:\n" +
                "\"How can I reduce my water bill?\"\n" +
                "\"How do I check for leaks?\"\n" +
                "\"What is my average daily usage?\"";
        }

        // ==================== NAVIGATION ====================
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function logoutUser() {
            if (confirm('Are you sure you want to logout? 👋')) {
                auth.signOut().then(() => {
                    fetch('../api/auth.php', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'logout' })
                    }).then(() => {
                        window.location.href = 'login.php';
                    });
                });
            }
        }

        window.sendMessage = sendMessage;
        window.handleKeyPress = handleKeyPress;
        window.askQuick = askQuick;
        window.toggleSidebar = toggleSidebar;
        window.logoutUser = logoutUser;
    </script>
</body>
</html>
